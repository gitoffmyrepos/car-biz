# ============================================================================
# Weekly Vehicle Leasing Platform - Environment Configuration
# Salvage-to-Lux Fleet Management (Next.js + FastAPI)
# ============================================================================
# Copy this file to .env and customize for your environment.
# DO NOT commit .env to version control - it may contain secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
APP_ENV=dev                          # dev | staging | prod
DEBUG=true                           # Enable debug mode (disable in production)
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Audit log retention (days)
AUDIT_LOG_RETENTION_DAYS=365

# Rate limiting configuration (JSON)
# RATE_LIMITS_CONFIG={"auth": "10/minute", "upload": "20/hour"}

# ----------------------------------------------------------------------------
# Database - PostgreSQL
# ----------------------------------------------------------------------------
# Connection string format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weekly_lease

# ----------------------------------------------------------------------------
# Cache - Redis
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Authentication - Keycloak OIDC
# ----------------------------------------------------------------------------
# Use existing Keycloak instance from homelab
OIDC_ISSUER_URL=http://keycloak.strategybase.io:8080/realms/fx-weekly-lease
OIDC_CLIENT_ID=fx-weekly-lease-app
OIDC_AUDIENCE=fx-weekly-lease-app
# OIDC_JWKS_URL is usually derived from issuer, but can be overridden
# OIDC_JWKS_URL=http://keycloak.../realms/.../protocol/openid-connect/certs
OIDC_REQUIRED_ROLES=admin,ops,customer

# ----------------------------------------------------------------------------
# Object Storage - MinIO (S3-compatible)
# ----------------------------------------------------------------------------
# Use existing MinIO instance from homelab
S3_ENDPOINT=minio.strategybase.io
S3_REGION=us-east-1                  # Required even if dummy for MinIO
S3_ACCESS_KEY=your-minio-access-key  # Prefer from Vault in production
S3_SECRET_KEY=your-minio-secret-key  # Prefer from Vault in production
S3_USE_SSL=true

# Bucket names (will be created if they don't exist)
S3_BUCKET_PAYMENTS=fx-weekly-lease-payments
S3_BUCKET_INSURANCE=fx-weekly-lease-insurance
S3_BUCKET_INCIDENTS=fx-weekly-lease-incidents

# Signed URL TTL in seconds (5 minutes default)
S3_SIGNED_URL_TTL_SECONDS=300

# ----------------------------------------------------------------------------
# Secrets Management - HashiCorp Vault
# ----------------------------------------------------------------------------
# Use existing Vault instance from homelab
VAULT_ADDR=http://vault.strategybase.io:8200
VAULT_AUTH_METHOD=token              # token (dev) | k8s (production)
# For Kubernetes auth:
# VAULT_ROLE=fx-weekly-lease-dev

# Transit encryption key for sensitive metadata
VAULT_TRANSIT_KEY_NAME=fx-weekly-lease-dev-transit

# KV v2 secret path prefix
VAULT_KV_PATH_PREFIX=secret/fx-weekly-lease/dev

# ----------------------------------------------------------------------------
# Email Delivery - Resend
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key  # Prefer from Vault
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ----------------------------------------------------------------------------
# Container Registry - Nexus
# ----------------------------------------------------------------------------
NEXUS_REGISTRY_HOST=nexus.strategybase.io:8082
NEXUS_REPOSITORY_PREFIX=sb-custom-docker-images
# NEXUS_USERNAME and NEXUS_PASSWORD should come from Vault or CI secrets
# NEXUS_USERNAME=
# NEXUS_PASSWORD=

# ----------------------------------------------------------------------------
# Integration Mode Flags
# ----------------------------------------------------------------------------
# Set to true to use existing homelab services
USE_EXISTING_HOMELAB_MINIO=true
USE_EXISTING_HOMELAB_VAULT=true
USE_EXISTING_HOMELAB_KEYCLOAK=true

# ----------------------------------------------------------------------------
# FX Reference Path (for pattern discovery)
# ----------------------------------------------------------------------------
FX_REFERENCE_ROOT=/home/kelvin/SB-HomeLAb/FX

# ----------------------------------------------------------------------------
# Frontend Public Variables (exposed to browser)
# ----------------------------------------------------------------------------
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_OIDC_PROVIDER_LABEL=Sign in with Keycloak

# ----------------------------------------------------------------------------
# Recovery Workflow Configuration
# ----------------------------------------------------------------------------
# Set to false to disable recovery/tow workflow (for compliance reasons)
ENABLE_RECOVERY_WORKFLOW=true

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
# ENABLE_CUSTOMER_DOCUMENT_REDOWNLOAD=false  # Strict mode: customers can't re-download
# BANNED_CUSTOMER_HISTORICAL_ACCESS=true     # Allow banned customers to view history

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
